# Normalize line endings across platforms.
* text=auto eol=lf

# Batch and PowerShell scripts stay CRLF-safe for Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.svg text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Explicitly mark the lockfile as generated.
/pnpm-lock.yaml -diff